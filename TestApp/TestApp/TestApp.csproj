    <Compile Include="CrashReportData.cs" />
    <Compile Include="SystemDiagnostics.cs" />
    <Compile Include="HangDetector.cs" />
    <Compile Include="MiniDumpWriter.cs" />
    <Compile Include="RecommendationEngine.cs" />
    <Compile Include="CrashPatternAnalyzer.cs" />
    <Compile Include="MemoryInspector.cs" />
    <Compile Include="BasicDisassembler.cs" />
    <Compile Include="StringExtractor.cs" />
    <Compile Include="EntropyAnalyzer.cs" />
    <Compile Include="ThreadAnalyzer.cs" />
    <Compile Include="CompanionLogReader.cs" />
    <Compile Include="EngineDetector.cs" />
    <Compile Include="ApiHookDetector.cs" />
    <Compile Include="ProcessEnvironmentReader.cs" />
    <Compile Include="WerReportReader.cs" />
    <Compile Include="ManifestReader.cs" />
    <Compile Include="DisassemblyHelper.cs" />
    <Compile Include="ClrAssemblyReader.cs" />
    <Compile Include="DllScanner.cs" />
    <Compile Include="DllScanForm.cs" />
    <Compile Include="ReadinessAnalyzer.cs" />
    <Compile Include="Can I Run It.cs" />
    <Compile Include="Can I Run It.Designer.cs">
      <DependentUpon>Can I Run It.cs</DependentUpon>
    </Compile>
    <Compile Include="AboutForm.cs" />
    <Compile Include="ManagedExceptionReader.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <None Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CopyHelper" AfterTargets="Build">
    <PropertyGroup>
      <Helper32Exe>$(SolutionDir)TestAppHelper32\bin\$(Configuration)\TestAppHelper32.exe</Helper32Exe>
      <Helper64Exe>$(SolutionDir)TestAppHelper64\bin\$(Configuration)\TestAppHelper64.exe</Helper64Exe>
      <ClrMd32Dll>$(SolutionDir)TestAppHelper32\bin\$(Configuration)\Microsoft.Diagnostics.Runtime.dll</ClrMd32Dll>
      <ClrMd64Dll>$(SolutionDir)TestAppHelper64\bin\$(Configuration)\Microsoft.Diagnostics.Runtime.dll</ClrMd64Dll>
    </PropertyGroup>
    <!-- 32-bit helper and its DLLs -->
    <Copy SourceFiles="$(Helper32Exe)" DestinationFolder="$(OutputPath)" Condition="Exists('$(Helper32Exe)')" ContinueOnError="true" />
    <Copy SourceFiles="$(ClrMd32Dll)" DestinationFolder="$(OutputPath)" Condition="Exists('$(ClrMd32Dll)')" ContinueOnError="true" />
    <!-- 64-bit helper and its DLLs -->
    <Copy SourceFiles="$(Helper64Exe)" DestinationFolder="$(OutputPath)" Condition="Exists('$(Helper64Exe)')" ContinueOnError="true" />
    <Copy SourceFiles="$(ClrMd64Dll)" DestinationFolder="$(OutputPath)" Condition="Exists('$(ClrMd64Dll)')" ContinueOnError="true" />
  </Target>
</Project>